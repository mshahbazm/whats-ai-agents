# Copy to .env.local and fill in. Never commit .env.local.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain you have verified in Resend
EMAIL_FROM=Shahbaz's Assistant <assistant@your-verified-domain.com>

# Optional safety net: only allow emails to this domain (empty = any address)
ALLOWED_EMAIL_DOMAIN=yopmail.com

# Agent settings
MAX_STEPS=8
TIMEZONE=Asia/Karachi
# false = every request starts blank (used in the lecture to show why memory matters)
REMEMBER_CONVERSATION=false
