# Copy to .env.local and fill in. Never commit .env.local.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain you have verified in Resend
FROM_ADDRESS=Shahbaz's Assistant <assistant@your-verified-domain.com>


# Agent settings
MAX_STEPS=8
TIMEZONE=Asia/Karachi

# Password required to use the agent
DEMO_PASSWORD=
