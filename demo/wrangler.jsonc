{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whats-ai-agents-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // With memory on, chat history, to-dos and reminders are saved here.
  // Secrets (API keys, DEMO_PASSWORD) are set with `wrangler secret put`, never in this file.
  "kv_namespaces": [{ "binding": "DATA", "id": "20e9c1acc4b8435798eadca9cc275ff7" }],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "MAX_STEPS": "8",
    "TIMEZONE": "Asia/Karachi"
  }
}
